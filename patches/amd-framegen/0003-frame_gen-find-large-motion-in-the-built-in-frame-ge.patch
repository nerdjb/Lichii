diff --git a/src/video_core/host_shaders/fg_flow_median.comp b/src/video_core/host_shaders/fg_flow_median.comp
new file mode 100644
index 0000000000..aeec90b018
--- /dev/null
+++ b/src/video_core/host_shaders/fg_flow_median.comp
@@ -0,0 +1,46 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Frame generation: 3x3 median of the finest motion field, per component, to drop stray vectors.
+
+#version 460 core
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D Vectors;
+layout(binding = 1, rg16f) uniform writeonly image2D OutVectors;
+
+layout(push_constant) uniform PushConstants {
+    ivec2 size;
+};
+
+float Median9(float v[9]) {
+    for (int i = 1; i < 9; ++i) {
+        const float key = v[i];
+        int j = i - 1;
+        while (j >= 0 && v[j] > key) {
+            v[j + 1] = v[j];
+            --j;
+        }
+        v[j + 1] = key;
+    }
+    return v[4];
+}
+
+void main() {
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, size))) {
+        return;
+    }
+    const ivec2 last = size - 1;
+    float xs[9];
+    float ys[9];
+    for (int y = -1; y <= 1; ++y) {
+        for (int x = -1; x <= 1; ++x) {
+            const vec2 v = texelFetch(Vectors, clamp(p + ivec2(x, y), ivec2(0), last), 0).xy;
+            xs[(y + 1) * 3 + x + 1] = v.x;
+            ys[(y + 1) * 3 + x + 1] = v.y;
+        }
+    }
+    imageStore(OutVectors, p, vec4(Median9(xs), Median9(ys), 0.0, 0.0));
+}
diff --git a/src/video_core/host_shaders/fg_flow_refine.comp b/src/video_core/host_shaders/fg_flow_refine.comp
new file mode 100644
index 0000000000..8220d9e2a1
--- /dev/null
+++ b/src/video_core/host_shaders/fg_flow_refine.comp
@@ -0,0 +1,98 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Frame generation: refines the motion of the next coarser level at this level's resolution. The
+// candidates are the 3x3-median coarse vectors under the texel and its four neighbours (scaled to
+// this level), and zero, each tried with offsets of -1..1 texel; the cost is the same 5x5 window
+// brightness difference and length penalty as the full search.
+
+#version 460 core
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D CurrentLuma;
+layout(binding = 1) uniform sampler2D PreviousLuma;
+layout(binding = 2) uniform sampler2D CoarseVectors;
+layout(binding = 3, rg16f) uniform writeonly image2D OutVectors;
+
+layout(push_constant) uniform PushConstants {
+    ivec2 size;
+    ivec2 coarse_size;
+    int ratio;
+    float lambda;
+};
+
+const int WIN = 2;
+const int TAPS = (2 * WIN + 1) * (2 * WIN + 1);
+
+float Median9(float v[9]) {
+    for (int i = 1; i < 9; ++i) {
+        const float key = v[i];
+        int j = i - 1;
+        while (j >= 0 && v[j] > key) {
+            v[j + 1] = v[j];
+            --j;
+        }
+        v[j + 1] = key;
+    }
+    return v[4];
+}
+
+ivec2 CoarseMedian(ivec2 c) {
+    const ivec2 last = coarse_size - 1;
+    c = clamp(c, ivec2(0), last);
+    float xs[9];
+    float ys[9];
+    for (int y = -1; y <= 1; ++y) {
+        for (int x = -1; x <= 1; ++x) {
+            const vec2 v = texelFetch(CoarseVectors, clamp(c + ivec2(x, y), ivec2(0), last), 0).xy;
+            xs[(y + 1) * 3 + x + 1] = v.x;
+            ys[(y + 1) * 3 + x + 1] = v.y;
+        }
+    }
+    return ivec2(round(vec2(Median9(xs), Median9(ys))));
+}
+
+void main() {
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, size))) {
+        return;
+    }
+    const ivec2 last = size - 1;
+    float current[TAPS];
+    for (int y = -WIN; y <= WIN; ++y) {
+        for (int x = -WIN; x <= WIN; ++x) {
+            const ivec2 q = clamp(p + ivec2(x, y), ivec2(0), last);
+            current[(y + WIN) * (2 * WIN + 1) + x + WIN] = texelFetch(CurrentLuma, q, 0).r;
+        }
+    }
+    const ivec2 coarse = p / ratio;
+    const ivec2 bases[6] = ivec2[](CoarseMedian(coarse) * ratio,
+                                   CoarseMedian(coarse + ivec2(0, -1)) * ratio,
+                                   CoarseMedian(coarse + ivec2(0, 1)) * ratio,
+                                   CoarseMedian(coarse + ivec2(-1, 0)) * ratio,
+                                   CoarseMedian(coarse + ivec2(1, 0)) * ratio, ivec2(0));
+    float best = 1e30;
+    ivec2 best_vector = ivec2(0);
+    for (int b = 0; b < 6; ++b) {
+        for (int dy = -1; dy <= 1; ++dy) {
+            for (int dx = -1; dx <= 1; ++dx) {
+                const ivec2 v = bases[b] + ivec2(dx, dy);
+                float cost = lambda * float(TAPS) * length(vec2(v));
+                for (int y = -WIN; y <= WIN; ++y) {
+                    for (int x = -WIN; x <= WIN; ++x) {
+                        const ivec2 q = clamp(p + ivec2(x, y), ivec2(0), last);
+                        const float previous =
+                            texelFetch(PreviousLuma, clamp(q + v, ivec2(0), last), 0).r;
+                        cost += abs(current[(y + WIN) * (2 * WIN + 1) + x + WIN] - previous);
+                    }
+                }
+                if (cost < best) {
+                    best = cost;
+                    best_vector = v;
+                }
+            }
+        }
+    }
+    imageStore(OutVectors, p, vec4(vec2(best_vector), 0.0, 0.0));
+}
diff --git a/src/video_core/host_shaders/fg_flow_search.comp b/src/video_core/host_shaders/fg_flow_search.comp
new file mode 100644
index 0000000000..4efe949361
--- /dev/null
+++ b/src/video_core/host_shaders/fg_flow_search.comp
@@ -0,0 +1,59 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Frame generation: full motion search on the coarsest brightness level. For each texel, every
+// offset within `radius` texels is tried; the cost is the summed brightness difference over a 5x5
+// window plus a small penalty on the offset's length, so flat areas keep zero motion. The result is
+// the offset from the texel to where its content was in the previous frame, in texels.
+
+#version 460 core
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D CurrentLuma;
+layout(binding = 1) uniform sampler2D PreviousLuma;
+layout(binding = 2, rg16f) uniform writeonly image2D OutVectors;
+
+layout(push_constant) uniform PushConstants {
+    ivec2 size;
+    int radius;
+    float lambda;
+};
+
+const int WIN = 2;
+const int TAPS = (2 * WIN + 1) * (2 * WIN + 1);
+
+void main() {
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, size))) {
+        return;
+    }
+    const ivec2 last = size - 1;
+    float current[TAPS];
+    for (int y = -WIN; y <= WIN; ++y) {
+        for (int x = -WIN; x <= WIN; ++x) {
+            const ivec2 q = clamp(p + ivec2(x, y), ivec2(0), last);
+            current[(y + WIN) * (2 * WIN + 1) + x + WIN] = texelFetch(CurrentLuma, q, 0).r;
+        }
+    }
+    float best = 1e30;
+    ivec2 best_vector = ivec2(0);
+    for (int vy = -radius; vy <= radius; ++vy) {
+        for (int vx = -radius; vx <= radius; ++vx) {
+            const ivec2 v = ivec2(vx, vy);
+            float cost = lambda * float(TAPS) * length(vec2(v));
+            for (int y = -WIN; y <= WIN; ++y) {
+                for (int x = -WIN; x <= WIN; ++x) {
+                    const ivec2 q = clamp(p + ivec2(x, y), ivec2(0), last);
+                    const float previous = texelFetch(PreviousLuma, clamp(q + v, ivec2(0), last), 0).r;
+                    cost += abs(current[(y + WIN) * (2 * WIN + 1) + x + WIN] - previous);
+                }
+            }
+            if (cost < best) {
+                best = cost;
+                best_vector = v;
+            }
+        }
+    }
+    imageStore(OutVectors, p, vec4(vec2(best_vector), 0.0, 0.0));
+}
diff --git a/src/video_core/host_shaders/fg_luma_down.comp b/src/video_core/host_shaders/fg_luma_down.comp
new file mode 100644
index 0000000000..aa29f270d2
--- /dev/null
+++ b/src/video_core/host_shaders/fg_luma_down.comp
@@ -0,0 +1,37 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Frame generation: one level of the brightness pyramid the motion search runs on. Each destination
+// texel is the mean of a factor x factor block of source texels (factor even), read as bilinear taps
+// that fall between 2x2 source texels; from the colour frame it stores the block's luma.
+
+#version 460 core
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) uniform sampler2D Source;
+layout(binding = 1, r16f) uniform writeonly image2D Destination;
+
+layout(push_constant) uniform PushConstants {
+    ivec2 dst_size;
+    vec2 inv_src_size;
+    int factor;
+    int from_rgb;
+};
+
+void main() {
+    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, dst_size))) {
+        return;
+    }
+    const int taps = factor / 2;
+    float sum = 0.0;
+    for (int y = 0; y < taps; ++y) {
+        for (int x = 0; x < taps; ++x) {
+            const vec2 pos = vec2(p * factor + ivec2(2 * x + 1, 2 * y + 1)) * inv_src_size;
+            const vec4 color = texture(Source, pos);
+            sum += from_rgb != 0 ? dot(color.rgb, vec3(0.299, 0.587, 0.114)) : color.r;
+        }
+    }
+    imageStore(Destination, p, vec4(sum / float(taps * taps)));
+}
