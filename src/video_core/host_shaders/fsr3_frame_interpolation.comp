// Frame generation: builds the frame at blend_factor between the previous and the current game
// frame. Each pixel tries several motion vectors: the field's bilinear value (slightly preferred),
// the vectors of the 3x3 field texels around it, and zero. For each it reads the previous frame
// where the content was and the current frame where it went, and keeps the vector whose two
// samples agree best. Picking per pixel keeps objects that hold still on screen (Link, the HUD)
// from smearing into a moving background and the other way round; blending the samples of the
// winning vector moves the picture instead of cross-fading it.

#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D CurrentFrame;
layout(binding = 1) uniform sampler2D PreviousFrame;
layout(binding = 2) uniform sampler2D MotionVectors;
layout(binding = 3, rgba8) uniform writeonly image2D OutGeneratedFrame;

layout(push_constant) uniform PushConstants {
    vec2 inv_render_size;
    vec2 render_size;
    float blend_factor;
    float texel_pixels; // presented pixels per motion field texel
};

const float BILINEAR_PREFERENCE = 0.02;

vec2 g_uv;
float g_best;
vec4 g_color;

vec4 SampleClamped(sampler2D image, vec2 uv) {
    // The sampler clamps to a black border: stay half a pixel inside the frame.
    return texture(image, clamp(uv, 0.5 * inv_render_size, 1.0 - 0.5 * inv_render_size));
}

void Try(vec2 field_vector, float preference) {
    // Field vectors are in field texels, from a current-frame position to where it was before.
    const vec2 motion = field_vector * texel_pixels * inv_render_size;
    const vec4 previous = SampleClamped(PreviousFrame, g_uv + motion * blend_factor);
    const vec4 current = SampleClamped(CurrentFrame, g_uv - motion * (1.0 - blend_factor));
    const float difference = dot(abs(previous.rgb - current.rgb), vec3(1.0 / 3.0)) - preference;
    if (difference < g_best) {
        g_best = difference;
        g_color = mix(previous, current, blend_factor);
    }
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(render_size.x) || p.y >= int(render_size.y)) {
        return;
    }
    const vec2 pixel = vec2(p) + 0.5;
    g_uv = pixel * inv_render_size;
    g_best = 1e30;
    g_color = vec4(0.0);

    const ivec2 field_size = textureSize(MotionVectors, 0);
    const vec2 field_pos = clamp(pixel / texel_pixels, vec2(0.5), vec2(field_size) - 0.5);
    Try(texture(MotionVectors, field_pos / vec2(field_size)).xy, BILINEAR_PREFERENCE);

    const ivec2 texel = clamp(ivec2(pixel / texel_pixels), ivec2(0), field_size - 1);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const ivec2 q = clamp(texel + ivec2(x, y), ivec2(0), field_size - 1);
            Try(texelFetch(MotionVectors, q, 0).xy, 0.0);
        }
    }
    Try(vec2(0.0), 0.0);

    imageStore(OutGeneratedFrame, p, g_color);
}
